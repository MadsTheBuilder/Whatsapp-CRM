# LLM (OpenRouter free chain or local Ollama)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MODEL=google/gemma-4-31b-it:free
MODEL_FALLBACKS=nvidia/nemotron-3-nano-30b-a3b:free,meta-llama/llama-3.3-70b-instruct:free
# Voice-critical reply call gets its own (bigger) model; qualify/summarize stay on MODEL.
# Test: gemma4:12b on local Ollama. Prod: a strong cloud model. Blank → reply uses MODEL.
REPLY_MODEL=

# Supabase (replaces fourthspace.db)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Company number — 360dialog send + inbound (bot talks to the AGENT only)
DIALOG360_API_KEY=
DIALOG360_API_URL=
DIALOG360_VERIFY_TOKEN=fourthspace-verify

# Agents are NOT configured here anymore — identity comes from the message, not env.
# Each agent is a row in the `agents` table: read_number (the number the bot reads
# inbound on) → agent_id + send_number (where suggestions/reminders/answers land).
# Seed one via POST /api/agents { agent_id, read_number, send_number, name } or a
# SQL insert. The receiving number on each inbound message selects the lane; an
# unregistered number is dropped. (Retired: AGENT_ID, AGENT_COMPANY_NUMBER, AGENT_NUMBER.)

COMPANY_BOT_NUMBER=       # E.164 no + — the bot's OWN number; read-pipe drops this chat (else it loops on its own cards)

# Which read-pipe feeds the brain the AGENT number's messages:
#   baileys   — dev, unofficial Baileys link (default). The dev's own scanned number
#               must have an `agents` row (read_number = that number), else all
#               inbound is dropped.
#   dialog360 — real agent number on a SECOND 360dialog channel (coexistence).
#               Direction + lane both come from the webhook's display_phone_number.
AGENT_PIPE=baileys
# dialog360 mode: point the agent number's webhook at /agent-webhook in the 360dialog
# dashboard. It reuses DIALOG360_VERIFY_TOKEN above for the GET handshake unless you
# set a per-number token here. No API key needed for RECEIVING — receiving is webhook-push only.
AGENT_DIALOG360_VERIFY_TOKEN=

# The agent number's own 360dialog SEND channel (key + URL). Only the portal lead-relay
# (goyzer.ts) uses these, so the first relayed message goes out from the AGENT's own
# number per CLAUDE.md. Leave the KEY blank to fall back to the company bot's channel.
# If the key is set but the URL is blank, DIALOG360_API_URL is reused.
AGENT_DIALOG360_API_KEY=
AGENT_DIALOG360_API_URL=

# Baileys read-pipe (agent's number). Auth keys persisted under ./baileys_auth
BAILEYS_AUTH_DIR=./baileys_auth

# Voice-card distill: real hand-sent msgs needed before a fold runs. Omit for the
# default (20). Set low (e.g. 4) only for prototype testing, then remove.
DISTILL_THRESHOLD=

PORT=3000
