# Anthropic — required (qualify + reply generation run through this key)
ANTHROPIC_API_KEY=sk-ant-...

# Model for qualify + reply calls. Default claude-sonnet-5.
# Swap to claude-haiku-4-5 to cut cost/latency on the qualify call.
MODEL=claude-sonnet-5

# BSP selection: mock (default, no number needed) | meta (real Graph API send)
BSP=mock

# Single-agent demo tenant id — threaded through every record from day one.
AGENT_ID=agent_demo

# Webhook verify token — matches what you register in the Meta app dashboard.
VERIFY_TOKEN=fourthspace-verify

PORT=3000

# --- Only needed when BSP=meta (adding the Meta Cloud API test number) ---
META_PHONE_NUMBER_ID=
META_TOKEN=
